# .env.prod.template — copy to .env and fill in real secrets (DO NOT COMMIT .env)

# Public web interface / bridge endpoint
BRIDGE_SERVER_URL=https://suite.raumdock.org
OAUTH_REDIRECT_URI=https://suite.raumdock.org/auth/callback
PUBLIC_BASE_PATH=

# LiveKit credentials
LIVEKIT_URL=wss://voice.raumdock.org
LIVEKIT_API_KEY=replace_with_real_key
LIVEKIT_API_SECRET=replace_with_real_secret

# Public IP of the host serving LiveKit WebRTC media (ports 7881/tcp, 7882/udp).
# Required even on a single-server setup, because LiveKit's STUN-based
# auto-detection breaks behind double-NAT (Proxmox/LXC, certain hosting
# providers). Set this to the IP that external clients can actually reach
# on the WebRTC ports. Find it with:  curl https://api.ipify.org
LIVEKIT_NODE_IP=replace_with_public_ip

# Internal bot ↔ bridge channel for instant voice-state push.
# Both bot and bridge read these same values from this file. When unset,
# the bridge's /internal/voice-state-changed endpoint 503s and the system
# falls back to the existing 60-second permission-recheck loop — audio
# toggling still works, just with up to 60 s of lag.
# INTERNAL_BRIDGE_SECRET must be at least 16 characters. Generate with:
#   openssl rand -hex 24
INTERNAL_BRIDGE_SECRET=replace_with_random_min_16_chars
# In docker-compose this resolves via the service-DNS name. Local dev:
#   BRIDGE_INTERNAL_URL=http://localhost:8787
BRIDGE_INTERNAL_URL=http://bridge:8787

# Example usage:
# Windows PowerShell:
#   Copy-Item .env.prod.template .env
#   (Edit .env with your secrets)
# Linux / macOS:
#   cp .env.prod.template .env
# Then recreate the livekit container:
#   docker compose -f docker-compose.prod.yml up -d --no-deps --force-recreate livekit
# Check logs:
#   docker logs -f rdoc-suite-livekit
