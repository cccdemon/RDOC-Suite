# .env.prod.template - copy to .env on the server and fill in real secrets.
# DO NOT COMMIT the resulting .env.
#
# docker-compose.prod.yml passes this one file to caddy-rdoc, fleetplanner and
# mission-cover. Everything else those services need is set in compose itself
# (HOST, PORT, DATABASE_URL, PUBLIC_BASE_PATH, DATA_DIR).
# Authoritative key lists: apps/fleetplanner/src/config/env.ts and
# apps/mission-cover/src/config/env.ts.

# ---------------------------------------------------------------------------
# Public interface
# ---------------------------------------------------------------------------
# Origin the app builds absolute links from. compose maps it to WEB_PUBLIC_URL;
# the "/fleetplanner" prefix is added separately via PUBLIC_BASE_PATH.
FLEETPLANNER_PUBLIC_URL=https://suite.raumdock.org

# ---------------------------------------------------------------------------
# TLS - Caddy solves ACME over Cloudflare DNS-01 (deploy/caddy-rdoc/Caddyfile).
# ---------------------------------------------------------------------------
CF_API_TOKEN=replace_with_cloudflare_dns_token

# ---------------------------------------------------------------------------
# Fleetplanner
# ---------------------------------------------------------------------------
# Postgres password for the fleetplanner-db container. Used by the DB, the app's
# DATABASE_URL and the postgres-exporter - all three are built from this one
# value in compose. Generate with:  openssl rand -hex 24
FLEETPLANNER_DB_PASSWORD=replace_with_random_secret
# Session cookie signing key, min 32 chars. Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_random_min_32_chars

# Discord OAuth login (legacy alias pair - used when the FLEETPLANNER_* pair
# below is unset).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord app: Fleetplanner Bot (prod app 1509191397264064689).
DISCORD_FLEETPLANNER_CLIENT_ID=
DISCORD_FLEETPLANNER_CLIENT_SECRET=
DISCORD_FLEETPLANNER_BOT_TOKEN=
# Ed25519 public key of that app (Developer Portal -> Public Key). Enables the
# event-distribution approval buttons in DMs; set the app's Interactions
# Endpoint URL to <FLEETPLANNER_PUBLIC_URL>/fleetplanner/discord/interactions.
# Optional - approvals also work via the web inbox.
DISCORD_FLEETPLANNER_PUBLIC_KEY=

# Discord user ID auto-promoted to superadmin, plus the contact shown to users
# who need to reach that superadmin.
SUPERADMIN_DISCORD_ID=
SUPERADMIN_CONTACT=

# ---------------------------------------------------------------------------
# Mission-cover render microservice. SAME value for both services (compose
# passes this file to both). Min 32 chars; unset = the fleetplanner hides the
# cover feature. Generate with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
MISSIONCOVER_SERVICE_SECRET=replace_with_random_min_32_chars
MISSIONCOVER_PUBLIC_URL=https://suite.raumdock.org/cover
MISSIONCOVER_SERVICE_URL=http://mission-cover:3300

# ---------------------------------------------------------------------------
# Subraum voice deep-link (subraum.cc). MUST match the init-server's
# ROOM_AUTH_SECRET byte for byte; unset = the voice card is hidden.
# ---------------------------------------------------------------------------
SQUADLINK_ROOM_AUTH_SECRET=
SQUADLINK_WS_URL=wss://squadlink.raumdock.org/ws
SQUADLINK_STORE_URL=

# ---------------------------------------------------------------------------
# Grafana (monitoring.raumdock.org). The password has no default - compose
# refuses to start without it.
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_random_secret

# ---------------------------------------------------------------------------
# E2E test-login seam - leave UNSET on production. Setting it opens a login
# backdoor for synthetic e2e-* players and additionally needs
# E2E_ALLOW_IN_PROD=1 to take effect. See docs/TESTING.md.
# ---------------------------------------------------------------------------
# E2E_TEST_LOGIN_SECRET=
# E2E_ALLOW_IN_PROD=
# E2E_TEST_LOGIN_EXPIRES=

# Example usage:
# Windows PowerShell:
#   Copy-Item .env.prod.template .env
#   (Edit .env with your secrets)
# Linux / macOS:
#   cp .env.prod.template .env
# Then (re)deploy:
#   docker compose -f docker-compose.prod.yml up -d --build
