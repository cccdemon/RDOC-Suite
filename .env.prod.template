# .env.prod.template — copy to .env and fill in real secrets (DO NOT COMMIT .env)

# Public web interface / bridge endpoint
BRIDGE_SERVER_URL=https://suite.raumdock.org
OAUTH_REDIRECT_URI=https://suite.raumdock.org/auth/callback
PUBLIC_BASE_PATH=

# Fleetplanner web interface; PUBLIC_BASE_PATH=/fleetplanner is set in compose.
FLEETPLANNER_PUBLIC_URL=https://suite.raumdock.org

# Ed25519 public key of the Fleetplanner Discord app (Developer Portal → Public
# Key). Enables the FR-P1 event-distribution approval buttons in DMs; set the
# app's Interactions Endpoint URL to <FLEETPLANNER_PUBLIC_URL>/fleetplanner/discord/interactions.
# Optional — approvals also work via the web inbox (Partnerships → "Shared with us").
DISCORD_FLEETPLANNER_PUBLIC_KEY=

# Native Bridge Admin web UI exposure (controls ONLY /admin/* — backend routes
# used by Fleetplanner, Companion, relay bots, sessions, downloads, updater and
# WS signaling stay independent regardless of this value).
#   full     = native Bridge Admin UI unchanged (legacy default).
#   legacy   = native UI reachable by direct URL with a legacy banner, but
#              Dashboard/Raid Planer/Konfig removed from primary nav. Fleetplanner
#              is the normal operator UI; native admin reads as diagnostics.
#   disabled = /admin/* not registered (404); /health + all backend routes stay up.
# Fleetplanner is now the primary Mission Voice operator surface, so prod should
# run `legacy` (or `disabled` once you no longer need native diagnostics).
BRIDGE_ADMIN_UI_MODE=legacy

# LiveKit credentials
LIVEKIT_URL=wss://voice.raumdock.org
LIVEKIT_API_KEY=replace_with_real_key
LIVEKIT_API_SECRET=replace_with_real_secret

# Public IP of the host serving LiveKit WebRTC media (ports 7881/tcp, 7882/udp).
# Required even on a single-server setup, because LiveKit's STUN-based
# auto-detection breaks behind double-NAT (Proxmox/LXC, certain hosting
# providers). Set this to the IP that external clients can actually reach
# on the WebRTC ports. Find it with:  curl https://api.ipify.org
LIVEKIT_NODE_IP=replace_with_public_ip

# Internal bot ↔ bridge channel for instant voice-state push.
# Both bot and bridge read these same values from this file. When unset,
# the bridge's /internal/voice-state-changed endpoint 503s and the system
# falls back to the existing 60-second permission-recheck loop — audio
# toggling still works, just with up to 60 s of lag.
# INTERNAL_BRIDGE_SECRET must be at least 16 characters. Generate with:
#   openssl rand -hex 24
INTERNAL_BRIDGE_SECRET=replace_with_random_min_16_chars
# In docker-compose this resolves via the service-DNS name. Local dev:
#   BRIDGE_INTERNAL_URL=http://localhost:8787
BRIDGE_INTERNAL_URL=http://bridge:8787

# Fleetplanner → bridge internal admin API (/internal/fleet/*). Lets the
# fleetplanner superadmin manage bridge guild config + admins from the
# fleetplanner UI (/admin/bridge) without a second login on the bridge
# admin web UI. SAME value must be set for BOTH the bridge and fleetplanner
# services (compose passes this file to both). Separate from
# INTERNAL_BRIDGE_SECRET (bot-only). Min 32 chars. When unset, the bridge
# /internal/fleet/* endpoints 503 and the fleetplanner "Bridge" tab is hidden.
# Generate with:  openssl rand -hex 32
BRIDGE_FLEET_SECRET=replace_with_random_min_32_chars

# Mission-cover render microservice (FR-P4). SAME value must be set for BOTH the
# mission-cover and fleetplanner services (compose passes this file to both).
# Min 32 chars. When unset, the fleetplanner cover feature is hidden. Generate
# with:  openssl rand -hex 32
MISSIONCOVER_SERVICE_SECRET=replace_with_random_min_32_chars
# Public base URL for rendered cover images (Caddy exposes /cover/covers*).
MISSIONCOVER_PUBLIC_URL=https://suite.raumdock.org/cover
# Internal docker-network URL the fleetplanner uses to reach the render API.
MISSIONCOVER_SERVICE_URL=http://mission-cover:3300

# Relay-bots admin secret (Basic auth, user "admin"). ONE shared secret used by
# THREE parties — they MUST match or you get 401 "Relay bots sync failed":
#   - relay-bots service: ADMIN_PASSWORD (compose maps it from this var)
#   - bridge:       RELAY_BOTS_ADMIN_SECRET (metrics/restart proxy)
#   - fleetplanner: RELAY_BOTS_ADMIN_SECRET (pushes config / reload)
# REQUIRED: the relay-bots admin server fails closed and refuses to start on a
# non-loopback bind (compose uses ADMIN_HOST=0.0.0.0 so Prometheus can scrape
# /metrics over the docker network) when this is empty. The host port is
# published to 127.0.0.1 only, so this is defense-in-depth. /metrics stays
# unauthenticated. Generate with:  openssl rand -hex 24
RELAY_BOTS_ADMIN_SECRET=replace_with_random_secret

# Example usage:
# Windows PowerShell:
#   Copy-Item .env.prod.template .env
#   (Edit .env with your secrets)
# Linux / macOS:
#   cp .env.prod.template .env
# Then recreate the livekit container:
#   docker compose -f docker-compose.prod.yml up -d --no-deps --force-recreate livekit
# Check logs:
#   docker logs -f rdoc-suite-livekit
