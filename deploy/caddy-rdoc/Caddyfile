{
	admin off
	auto_https disable_redirects
	acme_dns cloudflare {env.CF_API_TOKEN}
}

suite.raumdock.org:9443 {
	# Root host has no landing page of its own — send the bare "/" to the
	# Fleetplanner, which is the public entry point. Exact-path matcher, so
	# only "/" is redirected; every other path falls through to the handlers
	# below (and ultimately the bridge catch-all). 302 = temporary, easy to
	# revert if the root ever gets its own page.
	handle / {
		redir * /fleetplanner 302
	}

	# FR-P2 cutover — the SPA web container (127.0.0.1:3210) is now the single
	# front door for the whole app. Its nginx serves the SPA and proxies
	# /api, /auth, /discord, /e2e and the remaining SSR pages to the backend.
	# The old shadow path redirects so bookmarks/links keep working.
	handle_path /fleetplanner-next* {
		redir * /fleetplanner{uri} 301
	}

	handle_path /fleetplanner* {
		reverse_proxy 127.0.0.1:3210 {
			@upstream_5xx status 5xx
			handle_response @upstream_5xx {
				error "upstream error" {http.reverse_proxy.status_code}
			}
		}
	}

	handle /monitoring* {
		reverse_proxy 127.0.0.1:3001
	}

	# Mission-cover service. Public: rendered images (/cover/covers*) + the
	# token-gated editor (/cover/edit*). The M2M render API (/cover/v1*) is NEVER
	# exposed — the fleetplanner reaches it over the internal docker network.
	# (Caddy orders handle blocks by path specificity, so the /cover/v1* 404
	# wins over the broader /cover* handler.) handle_path strips /cover so the
	# service sees /covers/<id>.png, /edit, /edit/save.
	handle /cover/v1* {
		respond 404
	}
	handle_path /cover* {
		reverse_proxy 127.0.0.1:3300
	}

	handle_path /downloads* {
		file_server {
			root /srv/downloads
		}
	}

	# Prometheus scrape endpoints must never be reachable from the public
	# internet. The fleetplanner serves /metrics under /fleetplanner/metrics
	# (handle_path strips the prefix to /metrics). Prometheus scrapes
	# fleetplanner:3200 over the internal docker network, so this does not
	# affect monitoring.
	handle /metrics* {
		respond 404
	}

	handle /fleetplanner/metrics* {
		respond 404
	}

	# Catch-all: the legacy bridge web UI was removed (voice redesign). Any
	# unmatched path now goes to the Fleetplanner, the public entry point.
	# Wrapped in a matcher-less `handle` so it is the LEAST-specific handle
	# (evaluated after every path-specific handle/handle_path above) — a bare
	# site-level `redir` would order ahead of them and catch every path.
	handle {
		redir * /fleetplanner 302
	}

	handle_errors {
		@server_error expression `{err.status_code} >= 500`
		handle @server_error {
			reverse_proxy 127.0.0.1:9091 {
				header_up X-Status-Code {err.status_code}
			}
		}
	}
}

voice.raumdock.org:9443 {
	reverse_proxy 127.0.0.1:7880
}

monitoring.raumdock.org:9443 {
	reverse_proxy 127.0.0.1:3001
}

# RDOC SquadLink Lite — serverless P2P voice-mesh signaling (InitConnection).
# Separate project (repo RDOC-SACompanion), only co-hosted here behind the shared
# front door. Caddy terminates TLS and forwards the WebSocket to the init
# container on loopback (deploy/docker-compose.proxy.yml). reverse_proxy upgrades
# WebSockets automatically. coturn is NOT here (STUN-only for now).
squadlink.raumdock.org:9443 {
	# Installer download (served from the caddy ./downloads volume).
	handle_path /download* {
		root * /srv/downloads/squadlink
		file_server browse
	}
	# Everything else → InitConnection (signaling + session REST + /j landing).
	handle {
		reverse_proxy 127.0.0.1:8090
	}
}
