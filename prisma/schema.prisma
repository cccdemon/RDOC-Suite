// Prisma schema for the Discord Channel Commander project.
// Generator output is the standard @prisma/client package.

generator client {
  provider = "prisma-client-js"
  output   = "../packages/db/generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Per-guild configuration of the bot.
// See CLAUDE.md §Datenmodell — GuildConfig.
model GuildConfig {
  guildId                String   @id
  enabled                Boolean  @default(false)
  commanderRoleIds       String   @default("[]") // JSON array of role snowflake IDs
  allowedVoiceChannelIds String   @default("[]") // JSON array of channel snowflake IDs
  bridgeMode             String   @default("external_voice") // "discord_channel" | "external_voice" | "bot_relay"
  logChannelId           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Audit log of commander push-to-talk sessions.
// See CLAUDE.md §Datenmodell — CommanderSession.
// Audio is never persisted; only session metadata.
model CommanderSession {
  sessionId      String    @id
  guildId        String
  userId         String
  voiceChannelId String?
  active         Boolean   @default(true)
  muted          Boolean   @default(false)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  @@index([guildId, userId])
  @@index([active])
}

// Bot-maintained cache of the live Discord voice-state for each user
// per guild. Populated by the bot via the GuildVoiceStates intent
// (voiceStateUpdate event + ready-time sync of guild.voiceStates.cache).
// Read by the bridge to enforce GuildConfig.allowedVoiceChannelIds.
// channelId = null means the user is currently not connected to any
// voice channel in that guild.
model UserVoiceState {
  guildId   String
  userId    String
  channelId String?
  updatedAt DateTime @updatedAt

  @@id([guildId, userId])
  @@index([guildId, channelId])
}

// === Phase B (rewritten 2026-05-24): two-tier auth (Admin → Commander) ===

// Discord users who are allowed to sign into the web admin UI for a
// given guild. First admin is seeded via `/cc admin add @user` from
// somebody with Manage Guild permission. Every additional admin is
// onboarded via single-use AdminInviteLink (no more `/cc admin add`
// proliferation, no more typing snowflakes in Discord).
model AdminUser {
  guildId   String
  userId    String
  // "admiral" = full power including managing other admins.
  // "vice_admiral" = full power EXCEPT touching other admins
  // (cannot add/remove/promote/demote others).
  // Default is "vice_admiral" so a forgotten value on the invite side
  // doesn't accidentally hand out the more-powerful role.
  role      String   @default("vice_admiral")
  // The bootstrap admin (the very first AdminUser per guild) is marked
  // protected = true. Protected admins cannot be removed, role-edited,
  // or self-edited by anyone via the UI — only by direct DB access.
  // Prevents an accidental or hostile lockout of the original operator.
  protected Boolean  @default(false)
  addedBy   String? // null for the bootstrap admin
  createdAt DateTime @default(now())

  @@id([guildId, userId])
}

// Single-use invite link generated by an existing Admin to onboard
// another Discord user as Admin. Bridge mints a 32-byte random token,
// persists only sha256(token) + metadata; the raw token is returned to
// the issuing admin once (so they can hand it off out of band). The
// invitee opens the link in a browser, completes Discord OAuth, the
// link is consumed (usedAt + usedBy set in a transaction with the
// AdminUser insert), and they land on the dashboard signed-in.
model AdminInviteLink {
  id        String    @id @default(cuid())
  guildId   String
  tokenHash String    @unique // sha256-hex of the raw token
  label     String // human-readable, e.g. "Alice" — for the admin's audit list
  // Role the invitee will receive on consume — chosen by the issuing
  // admiral when minting the link. Vice Admirals can also mint links
  // (currently they can't but reserved for future) but never with the
  // admiral role.
  role      String    @default("vice_admiral")
  createdBy String // Discord userId of the issuing admin
  expiresAt DateTime
  usedAt    DateTime?
  usedBy    String? // Discord userId of who consumed it
  createdAt DateTime  @default(now())

  @@index([guildId])
}

// Single-use download link for the Companion EXE. An admin mints a
// 32-byte random token in the admin UI, persists only sha256(token)
// + metadata; the raw token is returned to the issuing admin once
// so they can hand it off (e.g., DM the URL to the new commander).
// When the recipient opens the URL, the bridge fetches the latest
// release asset from GitHub and streams it back, marking the token
// used in a transaction so a second click 410s. Tokens stay in the
// table after consume for audit purposes.
model CompanionDownloadToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256-hex of the raw token (lookup)
  /** Raw token, stored alongside the hash so the admin UI can show a
   *  "COPY URL" button for unused links later. Set to null when the
   *  token is consumed so even a DB compromise can't replay a used
   *  link. Trade-off: a DB read leaks ALL unused tokens — acceptable
   *  for download links (worst case: attacker grabs the EXE which
   *  lives on the GitHub release anyway). */
  plaintext String?
  label     String // human-readable, e.g. "Alice" — audit
  createdBy String // Discord userId of the issuing admin
  expiresAt DateTime
  usedAt    DateTime?
  /** Best-effort identifier of the downloader. Either user agent or
   *  a coarse remote-IP hash, both for diagnostics — not auth. */
  usedFrom  String?
  createdAt DateTime  @default(now())

  @@index([createdBy])
}
