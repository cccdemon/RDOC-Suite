generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────────────
model User {
  id         String   @id @default(cuid())
  username   String
  avatarHash String?
  role       String   @default("crew") // superadmin | fleetoperator | crew
  active     Boolean  @default(true)
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  sessions           UserSession[]
  companionSessions  CompanionSession[]
  identities         UserIdentity[]
  ownedShips       UserShip[]
  createdOps       Operation[]
  leaderRoles      OperationLeader[]
  crewRequests     CrewAssignmentRequest[]
  captainedUnits   FleetUnit[]             @relation("UnitCaptain")
  seatAssignments  SeatAssignment[]
  guildMemberships GuildMembership[]
  ownedGuilds      Guild[]                 @relation("GuildOwner")
  missionVoiceParticipations MissionVoiceParticipant[]
  opPrimaryUnits   OpPrimaryUnit[]
}

// ── Guilds (multi-tenant: one Discord server = one tenant) ─────────
model Guild {
  id                     String    @id // Discord guild snowflake
  name                   String
  orgName                String?   // SC org name shown in op embeds, distinct from the Discord server name
  iconHash               String?
  ownerUserId            String? // fleetplanner user who installed the bot
  voiceChannelCategoryId String? // Discord category for operation voice channels
  admiralRoleId          String? // Discord role id → fleetoperator (optional mapping)
  reminderOffsetMin      Int       @default(15) // minutes before scheduledAt to send reminder DMs
  timezone               String    @default("Europe/Berlin") // IANA tz for scheduling UI (e.g. "America/New_York")
  globalVoiceRoleId      String?   // Discord role id for Global Radio Net users when mission voice is live
  commanderVoiceRoleId   String?   // Discord role id for Command Net users when mission voice is live
  discordInviteUrl       String?   // permanent Discord invite (e.g. https://discord.gg/raumdock) shown to non-member guests
  voiceEnabled           Boolean   @default(false) // SuperAdmin-gated feature flag for LiveKit voice sessions
  botInstalledAt         DateTime?
  active                 Boolean   @default(true)
  bannedAt               DateTime? // SuperAdmin ban: blocks (re)install + hides everywhere. null = not banned.
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  owner         User?               @relation("GuildOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  memberships   GuildMembership[]
  operations    Operation[]
  recurrences   OperationRecurrence[]
  voiceBots     GuildVoiceBot[]
  voiceChannels FleetVoiceChannel[]
  partnershipsSent     GuildPartnership[] @relation("PartnershipA")
  partnershipsReceived GuildPartnership[] @relation("PartnershipB")
}

// ── Guild partnerships (tenant federation) ─────────────────────────
// Guild A mints a single-use token; Guild B redeems it. Once active,
// both guilds see each other's operations with visibility "partners".
// Only sha256(token) is stored. Revocation is permanent.
model GuildPartnership {
  id          String    @id @default(cuid())
  guildAId    String // inviting guild (token issuer)
  guildBId    String? // null until the token is redeemed
  tokenHash   String    @unique // sha256-hex of the raw token
  label       String // human label, e.g. "Raumdock Alliance"
  status      String    @default("pending") // pending | active | revoked
  createdBy   String // fleetplanner userId of the minting user
  createdAt   DateTime  @default(now())
  activatedAt DateTime?

  guildA Guild  @relation("PartnershipA", fields: [guildAId], references: [id], onDelete: Cascade)
  guildB Guild? @relation("PartnershipB", fields: [guildBId], references: [id], onDelete: Cascade)

  @@unique([guildAId, guildBId])
  @@index([guildAId])
  @@index([guildBId])
  @@index([status])
}

// ── Event distribution (FR-P1) ─────────────────────────────────────
// One row per (operation, target partner guild). A host op's Discord
// scheduled event is offered to every active partner guild; each target
// gets its own EXTERNAL event (location = host op page) once approved or
// auto-shared. Directional sharing policy lives in PartnerSharePolicy.
model EventDistribution {
  id             String    @id @default(cuid())
  operationId    String
  sourceGuildId  String // host guild that created the op
  targetGuildId  String // partner guild the event is offered to
  status         String    @default("pending") // pending | approved | declined | auto | revoked
  contactUserId  String? // named contact person on the target guild (member of targetGuildId)
  discordEventId String? // scheduled-event id created in the target guild (null until posted)
  decidedByUserId String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, targetGuildId])
  @@index([targetGuildId])
  @@index([status])
}

// Directional sharing policy: ownerGuildId decides whether partnerGuildId's
// events auto-post into ownerGuildId's Discord. A dedicated directional row
// (not the symmetric GuildPartnership) avoids A/B-order confusion.
model PartnerSharePolicy {
  ownerGuildId         String // the guild that receives events and sets the policy
  partnerGuildId       String // the guild whose events this policy governs
  autoShare            Boolean @default(false)
  defaultContactUserId String? // pre-fill contact person for events from partnerGuildId
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@id([ownerGuildId, partnerGuildId])
  @@index([partnerGuildId])
}

model GuildVoiceBot {
  id                String   @id @default(cuid())
  guildId           String
  label             String
  botUserId         String
  tokenCiphertext   String
  tokenIv           String
  tokenSalt         String
  tokenTag          String
  assignedChannelId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  guild         Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  voiceChannels FleetVoiceChannel[]

  @@unique([guildId, botUserId])
  @@index([guildId])
  @@index([assignedChannelId])
}

model GuildMembership {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  operationId String?
  role      String   @default("crew") // fleetoperator | crew (PER guild)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([userId])
  @@index([operationId])
}

// ── OAuth identities ───────────────────────────────────────────────
// One user can have multiple provider-logins (discord + github + google).
// provider: "discord" | "github" | "google"
// providerId: the external account ID (Discord snowflake, GitHub user id, Google sub).
model UserIdentity {
  id         String   @id @default(cuid())
  userId     String
  provider   String // discord | github | google
  providerId String // external account id
  username   String? // display name at provider
  email      String?
  avatarUrl  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  csrfToken String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanionSession {
  id        String   @id // 64-char hex bearer token — stored in Tauri settings store
  userId    String
  operationId String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  // "full" = companion app login token (valid for all companion endpoints).
  // "mission-voice" = narrow token distributed via dccc://fleet-voice links;
  // only valid for the mission-voice polling endpoint, not full companion auth.
  scope     String   @default("full")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([operationId])
}

// ── Ship cache (SC wiki API) ───────────────────────────────────────
model Ship {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  manufacturer  String   @default("")
  size          String   @default("") // Small | Medium | Large | Capital | Vehicle
  career        String   @default("") // Combat | Transport | Support | Exploration …
  role          String   @default("") // Fighter | Gunship | Frigate | Corvette …
  minCrew       Int      @default(1)
  maxCrew       Int      @default(1)
  weaponCrew    Int      @default(0) // dedicated gunner seats
  operationCrew Int      @default(0) // dedicated engineer/operator seats
  imageUrl      String?
  rawJson       String   @default("{}")
  syncedAt      DateTime @default(now())

  fleetUnits FleetUnit[]
  owners     UserShip[]

  @@index([name])
}

model Location {
  id             String   @id @default(cuid())
  uuid           String   @unique
  slug           String   @unique
  name           String
  system         String
  systemSlug     String
  parentName     String   @default("")
  parentSlug     String   @default("")
  typeName       String   @default("")
  classification String   @default("")
  hidden         Boolean  @default(false)
  hasResources   Boolean  @default(false)
  webUrl         String?
  rawJson        String
  syncedAt       DateTime @default(now())

  @@index([name])
  @@index([systemSlug])
  @@index([classification])
}

model LocationSyncState {
  id            String    @id @default("singleton")
  enabled       Boolean   @default(true)
  intervalDays  Int       @default(7)
  lastRunAt     DateTime?
  lastResult    String?
  running       Boolean   @default(false)
  locationCount Int       @default(0)
  updatedAt     DateTime  @updatedAt
}

model UserShip {
  id        String   @id @default(cuid())
  userId    String
  shipId    String
  nickname  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ship Ship @relation(fields: [shipId], references: [id], onDelete: Cascade)

  @@unique([userId, shipId])
  @@index([userId])
  @@index([shipId])
}

// ── Ship-catalog sync state (singleton row, id = "singleton") ──────
// Drives the periodic SC-wiki refresh: how often to run, when it last
// ran, whether it's enabled, and whether a run is in flight (so the
// admin "Sync now" button can't kick off overlapping syncs).
model ShipSyncState {
  id           String    @id @default("singleton")
  enabled      Boolean   @default(true)
  intervalDays Int       @default(7)
  lastRunAt    DateTime?
  lastResult   String? // short human summary of the last run
  running      Boolean   @default(false)
  shipCount    Int       @default(0)
  updatedAt    DateTime  @updatedAt
}

// ── Operations ─────────────────────────────────────────────────────
model AppSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model Operation {
  id              String   @id @default(cuid())
  guildId         String // tenant — which Discord server this op belongs to
  title           String
  description     String   @default("")
  opType          String   @default("combat") // combat | pve | mining | salvage | training | mixed | exploration | transport | social
  visibility      String   @default("private") // private | partners | public — independent of status
  meetingSystem   String   @default("stanton")
  meetingLocation String   @default("")
  scheduledAt     DateTime
  status          String   @default("draft") // draft | open | locked | starting | in_progress | completed | cancelled
  minParticipants Int      @default(0) // minimum participants the host wants
  maxParticipants Int? // optional cap
  createdById     String
  discordEventId        String?   // id of the Discord scheduled event created when opened
  eventVoiceChannelId   String?   // Discord voice channel id to use as event location (overrides Guild.eventChannelId)
  globalVoiceRoom       String?   // LiveKit room name for Global Radio Net publish room
  commanderVoiceRoom    String?   // LiveKit room name for Command Net room
  reminderSentAt        DateTime? // set once reminder DMs have been dispatched; null = not yet sent
  recurrenceId          String?   // FR-P3: set on instances spawned from an OperationRecurrence series
  occurrenceAt          DateTime? // the series occurrence datetime this instance materialises
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guild                    Guild                     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdBy                User                      @relation(fields: [createdById], references: [id])
  recurrence               OperationRecurrence?      @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  leaders                  OperationLeader[]
  groups                   CompositionGroup[]
  units                    FleetUnit[]
  crewRequests             CrewAssignmentRequest[]
  voiceChannels            FleetVoiceChannel[]
  missionVoiceParticipants MissionVoiceParticipant[]
  primaryUnits             OpPrimaryUnit[]
  auditLogs                AuditLog[]
  questions                OpQuestion[]
  cover                    OpCover?
  distributions            EventDistribution[]

  @@index([recurrenceId])
}

// FR-P3: a recurring-operation series. Approach A — one native recurring
// Discord event (recurrence_rule) + a scheduler that rolling-spawns concrete
// Operation instances from templateJson. count/end are Fleetplanner-enforced
// (Discord can't store them).
model OperationRecurrence {
  id            String   @id @default(cuid())
  guildId       String
  createdById   String
  freq          String // weekly | biweekly | monthly_nth | yearly
  byWeekday     Int? // 0=Mon … 6=Sun (weekly/biweekly/monthly_nth)
  nthWeek       Int? // 1..5 nth weekday of month (monthly_nth)
  byMonth       Int? // 1..12 (yearly)
  byMonthDay    Int? // 1..31 (yearly)
  timeOfDay     String // "HH:MM" local
  timezone      String   @default("Europe/Berlin")
  anchorAt      DateTime // first occurrence (UTC) — biweekly parity anchor
  seriesEnd     DateTime? // stop spawning after this (Fleetplanner-enforced)
  seriesCount   Int? // stop after N occurrences
  spawnedCount  Int      @default(0)
  leadTimeHours Int      @default(168) // spawn the next instance this many hours ahead
  nextRunAt     DateTime // next occurrence to spawn
  lastSpawnedAt DateTime?
  active        Boolean  @default(true)
  templateJson  String // op blueprint (title, opType, system, location, visibility, …)
  discordRecurringEventId String? // native recurring Discord scheduled-event id
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild      Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  operations Operation[]

  @@index([guildId])
  @@index([active, nextRunAt])
}

// FR-P4: mission cover image rendered by the @rdoc-suite/mission-cover
// microservice. The fleetplanner stores only a reference (id + public URL);
// the image bytes live in the service's own volume.
model OpCover {
  opId      String   @id
  coverId   String // service-side artifact id (cov_...)
  url       String // public PNG URL
  width     Int
  height    Int
  preset    String
  format    String
  updatedAt DateTime @updatedAt

  operation Operation @relation(fields: [opId], references: [id], onDelete: Cascade)
}

// ── Audit log (per operation) ──────────────────────────────────────
// Who changed what. Actor is denormalised (username snapshot + optional
// fleetplanner userId) so entries survive user deletion without FK churn.
model AuditLog {
  id          String   @id @default(cuid())
  operationId String
  actorId     String? // fleetplanner userId (no FK)
  actor       String // username at the time
  action      String // "created" | "status:open" | "joined" | "question" | …
  detail      String   @default("")
  createdAt   DateTime @default(now())

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
}

// ── Ask the FleetOperator: per-op question queue ───────────────────
model OpQuestion {
  id          String    @id @default(cuid())
  operationId String
  askerId     String // fleetplanner userId (no FK)
  asker       String // username snapshot
  body        String
  answer      String?
  answeredBy  String?
  createdAt   DateTime  @default(now())
  answeredAt  DateTime?

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
}

// Manually-added Command Net participants. Captains of accepted units and
// Event/Raid/Wing leaders are resolved from their mission records; fleet-level
// admin roles do not grant mission voice by themselves.
model MissionVoiceParticipant {
  id          String   @id @default(cuid())
  operationId String
  userId      String
  addedById   String // fleetplanner user who added them
  globalVoice Boolean  @default(false)
  createdAt   DateTime @default(now())

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([operationId, userId])
  @@index([operationId])
  @@index([userId])
}

model CrewAssignmentRequest {
  id          String   @id @default(cuid())
  operationId String
  userId      String
  note        String?
  createdAt   DateTime @default(now())

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([operationId, userId])
  @@index([operationId])
  @@index([userId])
}

model OperationLeader {
  id          String @id @default(cuid())
  operationId String
  userId      String
  leaderRole  String @default("raid_leader") // event_leader | fleet_commander | raid_leader | wing_commander

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([operationId, userId])
}

// ── Composition template ───────────────────────────────────────────
model CompositionGroup {
  id          String @id @default(cuid())
  operationId String
  name        String
  order       Int    @default(0)

  operation    Operation                @relation(fields: [operationId], references: [id], onDelete: Cascade)
  requirements CompositionRequirement[]
}

model CompositionRequirement {
  id       String  @id @default(cuid())
  groupId  String
  category String // fps | capital | subcapital | fighter | support | ground | transport | mining | salvage | exploration | any
  label    String
  count    Int     @default(1)
  note     String?
  order    Int     @default(0)

  group      CompositionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fleetUnits FleetUnit[]
}

// ── Fleet units (ships + squads) ───────────────────────────────────
model FleetUnit {
  id          String @id @default(cuid())
  operationId String
  unitType    String @default("ship") // ship | squad | vehicle

  shipId    String? // → Ship.id  (null for FPS squads)
  squadName String? // e.g. "Alpha Squad"
  squadSize Int? // total incl. captain, 2–8

  // A ground vehicle is a crewable sub-unit carried by a parent ship unit.
  carrierUnitId String?

  captainId     String
  requirementId String?
  status        String   @default("pending") // pending | accepted | rejected
  captainNote   String?
  leaderNote    String?
  createdAt     DateTime @default(now())

  operation    Operation               @relation(fields: [operationId], references: [id], onDelete: Cascade)
  ship         Ship?                   @relation(fields: [shipId], references: [id])
  captain      User                    @relation("UnitCaptain", fields: [captainId], references: [id])
  requirement  CompositionRequirement? @relation(fields: [requirementId], references: [id])
  carrier      FleetUnit?              @relation("CarrierVehicles", fields: [carrierUnitId], references: [id], onDelete: Cascade)
  vehicles     FleetUnit[]             @relation("CarrierVehicles")
  seats        SeatAssignment[]
  voiceChannel FleetVoiceChannel?
  primaryForUsers OpPrimaryUnit[]
}

// A multi-position user (assigned to 2+ accepted units in an op) lives in only
// ONE Discord voice channel. This records which unit is that user's PRIMARY (main)
// channel — chosen by the user themselves or assigned by a mission leader. When
// absent, the system default applies (prefer an FPS/ground squad, else the first
// unit by createdAt). See services/primaryUnits.ts.
model OpPrimaryUnit {
  id          String   @id @default(cuid())
  operationId String
  userId      String
  unitId      String
  setByUserId String? // who set it (null = system default never persists; set on explicit choice)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit      FleetUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([operationId, userId])
  @@index([operationId])
  @@index([unitId])
}

model FleetVoiceChannel {
  id          String   @id @default(cuid())
  operationId String
  unitId      String   @unique
  guildId     String
  channelId   String
  channelName String   @default("")
  voiceBotId  String?
  createdAt   DateTime @default(now())

  operation Operation      @relation(fields: [operationId], references: [id], onDelete: Cascade)
  unit      FleetUnit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  guild     Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  voiceBot  GuildVoiceBot? @relation(fields: [voiceBotId], references: [id], onDelete: SetNull)

  @@unique([operationId, unitId])
  @@index([guildId])
  @@index([channelId])
  @@index([voiceBotId])
}

// ── Seat assignments ───────────────────────────────────────────────
model SeatAssignment {
  id       String  @id @default(cuid())
  unitId   String
  label    String // "Pilot", "Gunner 1", "Engineer 2", "FPS 1" …
  seatType String // pilot | gunner | operation | flex | fps
  order    Int
  active   Boolean @default(true)
  userId   String?

  fleetUnit FleetUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])
}
