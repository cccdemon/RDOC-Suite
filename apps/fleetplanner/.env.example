# Fleetplanner environment — copy to .env and fill in real values

# Server
PORT=3200
HOST=0.0.0.0
NODE_ENV=development

# Database (SQLite)
DATABASE_URL=file:./data/fleetplanner.db

# Session signing — generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_32_plus_char_random_string

# Public URL and base path
# In production: path must match Caddy handle_path prefix
WEB_PUBLIC_URL=https://suite.raumdock.org
PUBLIC_BASE_PATH=/fleetplanner

# Discord OAuth 2.0
# Create an app at https://discord.com/developers/applications
# Add redirect URI: <WEB_PUBLIC_URL><PUBLIC_BASE_PATH>/auth/callback
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Optional: Discord user ID to auto-promote to superadmin on first login
# Right-click your username in Discord (Developer Mode) → Copy User ID
SUPERADMIN_DISCORD_ID=

# Optional: Discord scheduled events
# Bot needs MANAGE_EVENTS permission in the target server.
# Event is created automatically when an operation status is set to "open".
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
# Optional: Discord Fleetplanner Bot used for scheduled events,
# feedback tickets, and temporary captain roles.
# If unset, Fleetplanner falls back to DISCORD_BOT_TOKEN.
DISCORD_FLEETPLANNER_CLIENT_ID=
DISCORD_FLEETPLANNER_BOT_TOKEN=
# Optional: voice channel to attach event to (makes it an in-voice event instead of external)
DISCORD_EVENT_CHANNEL_ID=
# Optional: manual Discord roles for accepted fleet captains
DISCORD_COMMANDER_ROLE_ID=
DISCORD_ADMIRAL_ROLE_ID=

# Optional: links sent by DM when a captain's unit is accepted.
FLEETPLANNER_VOICE_CLIENT_DOWNLOAD_URL=
FLEETPLANNER_VOICE_CLIENT_CONFIG_URL=

# Companion app OAuth — RDOC-RTC Bot (separate from the Fleetmanager Bot above).
# Issues bearer tokens for the companion app's fleet voice connection.
# Register redirect URI in RDOC-RTC Bot's Discord app:
#   <WEB_PUBLIC_URL><PUBLIC_BASE_PATH>/auth/discord/companion/callback
DISCORD_COMPANION_BOT_ID=
DISCORD_COMPANION_BOT_KEY=

# LiveKit (fleet unit voice rooms)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Relay bots integration
RELAY_BOTS_ADMIN_URL=http://relay-bots:8788
RELAY_BOTS_ADMIN_SECRET=
