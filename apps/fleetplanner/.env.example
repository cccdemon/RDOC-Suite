# Fleetplanner environment example.
#
# The authoritative list is the zod schema in src/config/env.ts — this file is a
# commented copy of it. A key that is not in that schema is silently dropped, so
# an entry here that the schema does not know is dead weight, not a feature.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3200
HOST=0.0.0.0
WEB_PUBLIC_URL=http://localhost:3200
# Path prefix the app is served under. Production runs behind Caddy's
# `handle_path /fleetplanner*`, which STRIPS the prefix — the app registers its
# routes unprefixed and adds this value back when it builds absolute links.
# Empty for local dev, "/fleetplanner" in prod (set by docker-compose.prod.yml).
PUBLIC_BASE_PATH=
# Fastify trustProxy: "true"/"false" or a comma-separated IP/CIDR allowlist.
# Unset uses the loopback + RFC1918 default (see src/config/env.ts).
# TRUST_PROXY=
# Force maintenance mode regardless of the superadmin toggle (1/true/on).
# MAINTENANCE_MODE=

# ---------------------------------------------------------------------------
# Database — SQLite locally, PostgreSQL in production
# ---------------------------------------------------------------------------
DATABASE_URL=file:./data/fleetplanner.db

# ---------------------------------------------------------------------------
# Session signing
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
SESSION_SECRET=change_me_to_a_32_plus_char_random_string

# ---------------------------------------------------------------------------
# Discord OAuth login
# Register:
#   <WEB_PUBLIC_URL><PUBLIC_BASE_PATH>/auth/discord/callback
#   <WEB_PUBLIC_URL><PUBLIC_BASE_PATH>/auth/discord/link/callback
#   <WEB_PUBLIC_URL><PUBLIC_BASE_PATH>/guilds/added
# Login uses DISCORD_FLEETPLANNER_CLIENT_ID/_SECRET, falling back to
# DISCORD_CLIENT_ID/_SECRET.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: Discord user ID auto-promoted to superadmin on first login.
SUPERADMIN_DISCORD_ID=
# Optional free-text contact shown to users who need to reach the superadmin.
SUPERADMIN_CONTACT=

# ---------------------------------------------------------------------------
# Discord app: Fleetplanner Bot (the only bot — REST-only, no gateway)
# Required for scheduled events, feedback tickets, DMs, announcements and the
# interaction buttons.
# ---------------------------------------------------------------------------
DISCORD_FLEETPLANNER_CLIENT_ID=
DISCORD_FLEETPLANNER_CLIENT_SECRET=
DISCORD_FLEETPLANNER_BOT_TOKEN=
# Ed25519 public key of the same app (Developer Portal → General Information).
# Required to verify incoming HTTP interactions; set the app's "Interactions
# Endpoint URL" to <WEB_PUBLIC_URL><PUBLIC_BASE_PATH>/discord/interactions.
DISCORD_FLEETPLANNER_PUBLIC_KEY=

# Discord endpoints. Defaults are the real ones; the only reason to override is
# the local test stack pointing them at tests/discord-mock. Any non-default
# value is logged loudly at boot.
# DISCORD_API_BASE=https://discord.com/api/v10
# DISCORD_AUTHORIZE_BASE=
# DISCORD_SITE_BASE=https://discord.com

# ---------------------------------------------------------------------------
# Captain DM links (optional; both unset = the DM has no voice section)
# ---------------------------------------------------------------------------
FLEETPLANNER_VOICE_CLIENT_DOWNLOAD_URL=
FLEETPLANNER_VOICE_CLIENT_CONFIG_URL=

# ---------------------------------------------------------------------------
# Mission-cover render microservice
# Secret must match the service's MISSIONCOVER_SERVICE_SECRET (min 32 chars);
# unset = the cover feature is hidden.
# ---------------------------------------------------------------------------
MISSIONCOVER_SERVICE_URL=http://mission-cover:3300
MISSIONCOVER_SERVICE_SECRET=
MISSIONCOVER_PUBLIC_URL=https://suite.raumdock.org/cover

# ---------------------------------------------------------------------------
# Subraum voice deep-link (subraum.cc, formerly RDOC SquadLink)
# ---------------------------------------------------------------------------
# MUST be byte-for-byte identical to the init-server's ROOM_AUTH_SECRET. The
# join token is HMAC-SHA256(secret, room); unset = the voice card is hidden.
SQUADLINK_ROOM_AUTH_SECRET=
# Signaling server WebSocket URL the deep-link points at.
SQUADLINK_WS_URL=wss://squadlink.raumdock.org/ws
# Microsoft Store listing for Subraum; unset = the install link is hidden.
SQUADLINK_STORE_URL=

# ---------------------------------------------------------------------------
# E2E test-login seam — leave ALL of this unset in normal operation.
# With the secret set (>=32 chars) the /e2e/login + /e2e/cleanup backdoor exists
# for synthetic e2e-* players. In NODE_ENV=production it stays disabled unless
# E2E_ALLOW_IN_PROD is explicitly on. See docs/TESTING.md.
# ---------------------------------------------------------------------------
# E2E_TEST_LOGIN_SECRET=
# E2E_ALLOW_IN_PROD=
# E2E_TEST_LOGIN_EXPIRES=
