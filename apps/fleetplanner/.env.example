# Fleetplanner environment example

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3200
HOST=0.0.0.0
WEB_PUBLIC_URL=https://suite.raumdock.org
PUBLIC_BASE_PATH=/fleetplanner

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=file:./data/fleetplanner.db

# ---------------------------------------------------------------------------
# Session signing
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
SESSION_SECRET=change_me_to_a_32_plus_char_random_string

# ---------------------------------------------------------------------------
# Voice bot token encryption key (BYOK)
# Set this ONCE and never change it. GuildVoiceBot tokens are encrypted with
# this key. If unset, falls back to SESSION_SECRET — meaning tokens must be
# re-entered every time SESSION_SECRET rotates.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
VOICEBOT_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Discord OAuth login
# Register:
#   <WEB_PUBLIC_URL><PUBLIC_BASE_PATH>/auth/discord/callback
#   <WEB_PUBLIC_URL><PUBLIC_BASE_PATH>/auth/discord/link/callback
# Fleetplanner web login uses DISCORD_FLEETPLANNER_CLIENT_ID/_SECRET (set below),
# falling back to DISCORD_CLIENT_ID/_SECRET.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: Discord user ID to auto-promote to superadmin on first login.
SUPERADMIN_DISCORD_ID=

# ---------------------------------------------------------------------------
# Discord app: Fleetplanner Bot
# Required for scheduled events, feedback tickets, DMs, and event roles.
# Fleetplanner does not fall back to DISCORD_BOT_TOKEN.
# ---------------------------------------------------------------------------
DISCORD_FLEETPLANNER_CLIENT_ID=
DISCORD_FLEETPLANNER_CLIENT_SECRET=
DISCORD_FLEETPLANNER_BOT_TOKEN=

# Optional default event target. Fleetplanner is multi-tenant, so guilds can
# also be selected and configured through the UI.
DISCORD_GUILD_ID=

# Discord guild that is always allowed to use LiveKit voice sessions,
# regardless of the per-guild voiceEnabled flag. Set to your main guild ID.
RAUMDOCK_GUILD_ID=
DISCORD_EVENT_CHANNEL_ID=

# Optional manual Discord roles for accepted fleet captains.
DISCORD_COMMANDER_ROLE_ID=
DISCORD_ADMIRAL_ROLE_ID=

# ---------------------------------------------------------------------------
# Captain DM links
# ---------------------------------------------------------------------------
FLEETPLANNER_VOICE_CLIENT_DOWNLOAD_URL=
FLEETPLANNER_VOICE_CLIENT_CONFIG_URL=

# ---------------------------------------------------------------------------
# LiveKit fleet unit voice rooms
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RELAY_LIVEKIT_ROOM=voice-relay

# ---------------------------------------------------------------------------
# Relay-bots worker integration
# ---------------------------------------------------------------------------
RELAY_BOTS_ADMIN_URL=http://relay-bots:8788
RELAY_BOTS_ADMIN_SECRET=

# ---------------------------------------------------------------------------
# RDOC SquadLink Lite voice deep-link (commanders join the op CommandNet room)
# ---------------------------------------------------------------------------
# MUST be byte-for-byte identical to the SquadLink init-server's ROOM_AUTH_SECRET
# (RDOC-SACompanion server/init). Unset = feature hidden. The join token is
# HMAC-SHA256(secret, room) — the secret never leaves the server.
SQUADLINK_ROOM_AUTH_SECRET=
# Signaling server WebSocket URL the deep-link points at.
SQUADLINK_WS_URL=wss://squadlink.raumdock.org/ws
# Microsoft Store listing for SquadLink Lite. Set once the Store listing is live;
# unset = the "install the app" link is hidden.
SQUADLINK_STORE_URL=
