# Environment for the LOCAL TEST STACK (docker-compose.test.yml).
#
# Every value here is a throwaway test value that is committed on purpose: the
# stack must come up on any machine with `docker compose` and nothing else. None
# of these secrets exist anywhere but on localhost.
#
# NEVER copy this file to .env — it points Discord at a simulator and opens the
# E2E login backdoor.

# ── database ────────────────────────────────────────────────────────
FLEETPLANNER_DB_PASSWORD=testpassword
DATABASE_URL=postgresql://fleetplanner:testpassword@fleetplanner-db-test:5432/fleetplanner?schema=public

# ── app ─────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3200
# nginx (fleetplanner-web) is the front door, published on 8099. No path prefix
# locally — Caddy is what adds /fleetplanner in production.
WEB_PUBLIC_URL=http://localhost:8099
PUBLIC_BASE_PATH=
# The stack is a closed docker network behind nginx; trust its forwarded headers.
TRUST_PROXY=true
SESSION_SECRET=test-session-secret-not-for-production-0123456789
VOICEBOT_ENCRYPTION_KEY=test-voicebot-encryption-key-not-for-prod-0123456789

# ── Discord → the simulator (tests/discord-mock) ────────────────────
# Server-side REST calls resolve the container name on the compose network …
DISCORD_API_BASE=http://discord-mock:4400/api/v10
# … while the browser is redirected to the published host port.
DISCORD_AUTHORIZE_BASE=http://localhost:4400/api/v10
DISCORD_SITE_BASE=http://localhost:4400
DISCORD_FLEETPLANNER_BOT_TOKEN=mock-bot-token
DISCORD_FLEETPLANNER_CLIENT_ID=900000000000000001
DISCORD_FLEETPLANNER_CLIENT_SECRET=mock-client-secret
# Matches the simulator's default Ed25519 seed — see tests/discord-mock/README.md.
DISCORD_FLEETPLANNER_PUBLIC_KEY=7dc71677aeadc6971e9f91d8903345fe531bab14c92ab3dbd55d5a06fdea91f2
# The seeded mock user that /__mock/login-as defaults to.
SUPERADMIN_DISCORD_ID=200000000000000001
SUPERADMIN_CONTACT=e2e-operator

# ── E2E test-login seam (routes/e2eAuth.ts) ─────────────────────────
# Enabled here on purpose: this is the local stack, not an instance on the net.
E2E_TEST_LOGIN_SECRET=test-e2e-login-secret-local-stack-0123456789
E2E_ALLOW_IN_PROD=

# ── mission-cover ───────────────────────────────────────────────────
MISSIONCOVER_SERVICE_URL=http://mission-cover:3300
MISSIONCOVER_SERVICE_SECRET=test-missioncover-service-secret-0123456789
MISSIONCOVER_PUBLIC_URL=http://localhost:3399

# ── SquadLink (feature visible, points nowhere real) ────────────────
SQUADLINK_ROOM_AUTH_SECRET=test-squadlink-room-auth-secret-0123456789
SQUADLINK_WS_URL=ws://localhost:9/ws

# ── schedulers ──────────────────────────────────────────────────────
# Discord "Interested" polling: 3s locally so an E2E test can watch an RSVP
# arrive. Production keeps the 5-minute default.
EVENT_INTEREST_INTERVAL_MS=3000
