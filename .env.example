# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=

# Database (Prisma). For local dev: SQLite file in prisma/dev.db
DATABASE_URL="file:./dev.db"

# Bridge
BRIDGE_SERVER_URL="http://localhost:8787"
BRIDGE_HOST="0.0.0.0"
BRIDGE_PORT="8787"
SESSION_SECRET="change-me-to-a-32+-char-random-string"
OAUTH_REDIRECT_URI="http://localhost:8787/auth/callback"
COMPANION_REDIRECT_URI="dccc://auth"

# Public path prefix in front of the bridge when it sits behind a reverse
# proxy that does path-stripping (e.g. Traefik routes /dccc → bridge).
# Leave empty for local dev; set to "/dccc" in production behind Traefik.
PUBLIC_BASE_PATH=""

# LiveKit (audio bridge). `docker compose up -d livekit` starts a local
# server with these built-in dev credentials. For production, switch to
# a real LiveKit deployment and a properly random API secret.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Logging
LOG_LEVEL=info
