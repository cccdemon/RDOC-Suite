# RDOC-Suite environment example
# Keep Discord applications separated. Do not reuse a token as a fallback for
# another app unless that app is intentionally the same Discord application.

# ---------------------------------------------------------------------------
# Shared runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
SESSION_SECRET="change-me-to-a-32+-char-random-string"

# Shared Prisma (packages/db) dev database — SQLite for local dev. Fleetplanner
# uses its own PostgreSQL in production (see the Fleetplanner section below).
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Public path prefix
# ---------------------------------------------------------------------------
# Public path prefix when an app sits behind a reverse proxy that strips paths.
# Leave empty for local dev. Fleetplanner sets "/fleetplanner" in prod (compose).
PUBLIC_BASE_PATH=""

# ---------------------------------------------------------------------------
# Discord login OAuth (legacy fallback secret)
# Used as the OAuth client secret when DISCORD_FLEETPLANNER_CLIENT_SECRET is unset.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Discord app: Fleetplanner Bot
# Used by apps/fleetplanner for scheduled events, DMs, feedback tickets, and
# temporary event roles. Fleetplanner does not fall back to DISCORD_BOT_TOKEN.
# ---------------------------------------------------------------------------
DISCORD_FLEETPLANNER_CLIENT_ID=
DISCORD_FLEETPLANNER_BOT_TOKEN=
# Ed25519 public key of the Fleetplanner Discord app (Developer Portal → General
# Information → Public Key). Required for the FR-P1 event-distribution approval
# buttons. Set the app's "Interactions Endpoint URL" to
# <WEB_PUBLIC_URL>/discord/interactions. Without this, approvals still work via
# the web inbox (Partnerships → "Shared with us").
DISCORD_FLEETPLANNER_PUBLIC_KEY=

# Optional default event target. Fleetplanner is multi-tenant; operations are
# scoped per Discord guild and users see only servers they belong to.
# DISCORD_GUILD_ID=
# DISCORD_EVENT_CHANNEL_ID=
# SUPERADMIN_DISCORD_ID=
# DISCORD_COMMANDER_ROLE_ID=
# DISCORD_ADMIRAL_ROLE_ID=

# ---------------------------------------------------------------------------
# LiveKit (WebRTC SFU) was removed 2026-06-18 — orphaned since the voice stack
# (apps/bridge + apps/relay-bots) was removed 2026-06-12. Restore plan:
# docs/LIVEKIT-ARCHIVE-2026-06.md. Voice is being redesigned around
# RDOC SquadLink Lite (P2P), not a central SFU.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Fleetplanner
# apps/fleetplanner uses its own PostgreSQL database in production.
# ---------------------------------------------------------------------------
# FLEETPLANNER_DB_PASSWORD=
# FLEETPLANNER_PUBLIC_URL=https://suite.raumdock.org

# Fleetplanner OAuth redirects to register in the Discord Developer Portal:
#   https://suite.raumdock.org/fleetplanner/auth/discord/callback
#   https://suite.raumdock.org/fleetplanner/auth/discord/link/callback
#   https://suite.raumdock.org/fleetplanner/guilds/added
#
# Login OAuth client selection:
# - Fleetplanner web login uses DISCORD_FLEETPLANNER_CLIENT_ID, falling back to
#   the legacy DISCORD_CLIENT_ID alias.
# - DISCORD_FLEETPLANNER_CLIENT_SECRET (or legacy DISCORD_CLIENT_SECRET) is the
#   OAuth client secret.
# DISCORD_CLIENT_ID=

# Links sent by DM when a captain's unit is accepted.
# FLEETPLANNER_VOICE_CLIENT_DOWNLOAD_URL=
# FLEETPLANNER_VOICE_CLIENT_CONFIG_URL=

# Alternative login providers.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

