# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=

# Database (Prisma). For local dev: SQLite file in prisma/dev.db
DATABASE_URL="file:./dev.db"

# Bridge
BRIDGE_SERVER_URL="http://localhost:8787"
BRIDGE_HOST="0.0.0.0"
BRIDGE_PORT="8787"
SESSION_SECRET="change-me-to-a-32+-char-random-string"
OAUTH_REDIRECT_URI="http://localhost:8787/auth/callback"
COMPANION_REDIRECT_URI="dccc://auth"

# Public path prefix in front of the bridge when it sits behind a reverse
# proxy that does path-stripping. Leave empty for local dev and for the
# suite.raumdock.org root deployment.
PUBLIC_BASE_PATH=""

# LiveKit (audio bridge). `docker compose up -d livekit` starts a local
# server with these built-in dev credentials. For production, switch to
# a real LiveKit deployment and a properly random API secret.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Production public endpoints:
# BRIDGE_SERVER_URL="https://suite.raumdock.org"
# OAUTH_REDIRECT_URI="https://suite.raumdock.org/auth/callback"
# PUBLIC_BASE_PATH=""
# LIVEKIT_URL="wss://voice.raumdock.org"

# Voice relay bots (optional — omit if no relay bots are deployed)
# RELAY_GUILD_ID=         — default Discord guild for relay role checks
# RELAY_REQUIRED_ROLE_ID= — Discord role a user must have to get a publisher relay token
# RELAY_DISCORD_BOT_TOKEN=— bot token used for Discord role membership checks
# RELAY_LIVEKIT_ROOM=voice-relay
# RELAY_BOTS_ADMIN_URL=   — base URL of the relay bots service admin API (e.g. http://relay-bots:8788)
# RELAY_BOTS_SECRET=      — Bearer secret relay bots service uses for GET /relay-bots/service-config
# RELAY_BOTS_ADMIN_SECRET=— secret bridge uses when calling relay bots service admin API

# Monitoring (optional)
# LIVEKIT_PROMETHEUS_URL= — Prometheus metrics URL of the LiveKit server, scraped by the
#                           bridge /admin/monitoring/snapshot endpoint (e.g. http://livekit:7880/metrics)

# Fleetplanner (apps/fleetplanner) — uses its own PostgreSQL DB
# FLEETPLANNER_DB_PASSWORD= — password for the fleetplanner-db Postgres container
#                            (required; compose builds DATABASE_URL from it)
# FLEETPLANNER_PUBLIC_URL=https://suite.raumdock.org — public base for Discord
#                          event links + OAuth (defaults to suite.raumdock.org)
# Fleetplanner reads DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET (above) for its
# own OAuth login, plus these optional vars for posting Discord scheduled events:
# DISCORD_GUILD_ID=        — guild where fleet-op events are created
# DISCORD_EVENT_CHANNEL_ID=— voice channel id → creates in-voice events (optional)
# SUPERADMIN_DISCORD_ID=   — Discord user id bootstrapped as fleetplanner superadmin
# Fleetplanner is MULTI-TENANT: multiple Discord servers share one instance.
# Operations are scoped per Discord guild; users see only servers they belong
# to. Login uses the Discord `guilds` scope to map membership.
#
# Fleetplanner OAuth redirects to register in the Discord Developer Portal:
#   https://suite.raumdock.org/fleetplanner/auth/discord/callback
#   https://suite.raumdock.org/fleetplanner/auth/discord/link/callback
#   https://suite.raumdock.org/fleetplanner/guilds/added   (bot-invite return)
# DISCORD_FLEETPLANNER_CLIENT_ID= — bot application id used for the bot-invite
#   URL (falls back to DISCORD_CLIENT_ID). The bot needs MANAGE_EVENTS +
#   SEND_MESSAGES so it can post scheduled events on each tenant's Discord.
#
# Alternative login providers (optional — each shows a login button if set):
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET=
#   callback: https://suite.raumdock.org/fleetplanner/auth/github/callback
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
#   callback: https://suite.raumdock.org/fleetplanner/auth/google/callback
# (GitHub/Google users link their Discord at /fleetplanner/account to gain
#  access to servers — guild membership requires a linked Discord identity.)

# Logging
LOG_LEVEL=info
