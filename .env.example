# RDOC-Suite environment example
# Keep Discord applications separated. Do not reuse a token as a fallback for
# another app unless that app is intentionally the same Discord application.

# ---------------------------------------------------------------------------
# Shared runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
SESSION_SECRET="change-me-to-a-32+-char-random-string"

# Bridge / bot database. For local dev this is SQLite in prisma/dev.db.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Bridge public URLs
# ---------------------------------------------------------------------------
BRIDGE_SERVER_URL="http://localhost:8787"
BRIDGE_HOST="0.0.0.0"
BRIDGE_PORT="8787"
OAUTH_REDIRECT_URI="http://localhost:8787/auth/callback"
COMPANION_REDIRECT_URI="dccc://auth"

# Public path prefix in front of the bridge when it sits behind a reverse proxy
# that does path-stripping. Leave empty for local dev and suite root deployment.
PUBLIC_BASE_PATH=""

# Native Bridge Admin web UI exposure: full | legacy | disabled. Controls ONLY
# /admin/* — backend routes (fleet-internal, sessions, downloads, updater, relay,
# WS) stay independent. Default full. Prod runs legacy (see .env.prod.template).
# BRIDGE_ADMIN_UI_MODE=full

# Production examples:
# BRIDGE_SERVER_URL="https://suite.raumdock.org"
# OAUTH_REDIRECT_URI="https://suite.raumdock.org/auth/callback"
# PUBLIC_BASE_PATH=""

# ---------------------------------------------------------------------------
# Discord app: RDOC-RTC Bot
# Used by apps/bot and apps/bridge for /cc, bridge OAuth, guild/role checks,
# strategy channels, and Companion bridge auth.
# ---------------------------------------------------------------------------
DISCORD_RDOCRTC_BOT_TOKEN=
DISCORD_RDOCRTC_CLIENT_ID=
DISCORD_RDOCRTC_PUBLIC_KEY=
DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Discord app: Fleetplanner Bot
# Used by apps/fleetplanner for scheduled events, DMs, feedback tickets, and
# temporary event roles. Fleetplanner does not fall back to DISCORD_BOT_TOKEN.
# ---------------------------------------------------------------------------
DISCORD_FLEETPLANNER_CLIENT_ID=
DISCORD_FLEETPLANNER_BOT_TOKEN=

# Optional default event target. Fleetplanner is multi-tenant; operations are
# scoped per Discord guild and users see only servers they belong to.
# DISCORD_GUILD_ID=
# DISCORD_EVENT_CHANNEL_ID=
# SUPERADMIN_DISCORD_ID=
# DISCORD_COMMANDER_ROLE_ID=
# DISCORD_ADMIRAL_ROLE_ID=

# ---------------------------------------------------------------------------
# Discord app: Companion OAuth
# Used by Fleetplanner to issue Companion app fleet-voice bearer tokens.
# This may point to the RDOC-RTC app or to a dedicated Companion OAuth app.
# Register:
#   https://suite.raumdock.org/fleetplanner/auth/discord/companion/callback
# ---------------------------------------------------------------------------
DISCORD_COMPANION_BOT_ID=
DISCORD_COMPANION_BOT_KEY=

# ---------------------------------------------------------------------------
# Bridge relay-token role checks
# DISCORD_RELAY_BOT_TOKEN is only used by apps/bridge /relay/token to read
# Discord member roles. It is not the audio relay worker token.
# ---------------------------------------------------------------------------
# RELAY_GUILD_ID=
# RELAY_REQUIRED_ROLE_ID=
# DISCORD_RELAY_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Relay-bots worker service
# apps/relay-bots fetches config from the bridge. Fleetplanner voice bots are
# stored encrypted in the Fleetplanner DB (GuildVoiceBot) and synced to this
# service config.
# ---------------------------------------------------------------------------
# RELAY_LIVEKIT_ROOM=voice-relay
# RELAY_BOTS_ADMIN_URL=http://relay-bots:8788
# RELAY_BOTS_SECRET=
# RELAY_BOTS_ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Fleetplanner → bridge internal admin API (/internal/fleet/*)
# Lets the fleetplanner superadmin manage bridge guild config + admins from
# the fleetplanner UI (/admin/bridge) without a second login on the bridge
# admin web UI. The SAME value must be set for BOTH services. Min 32 chars.
# When unset the bridge /internal/fleet/* endpoints 503 and the fleetplanner
# "Bridge" tab is hidden. Separate from INTERNAL_BRIDGE_SECRET (bot-only).
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
# BRIDGE_INTERNAL_URL=http://bridge:8787
# BRIDGE_FLEET_SECRET=

# ---------------------------------------------------------------------------
# LiveKit
# ---------------------------------------------------------------------------
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
# Production example:
# LIVEKIT_URL="wss://voice.raumdock.org"

# ---------------------------------------------------------------------------
# Fleetplanner
# apps/fleetplanner uses its own PostgreSQL database in production.
# ---------------------------------------------------------------------------
# FLEETPLANNER_DB_PASSWORD=
# FLEETPLANNER_PUBLIC_URL=https://suite.raumdock.org

# Fleetplanner OAuth redirects to register in the Discord Developer Portal:
#   https://suite.raumdock.org/fleetplanner/auth/discord/callback
#   https://suite.raumdock.org/fleetplanner/auth/discord/link/callback
#   https://suite.raumdock.org/fleetplanner/guilds/added
#
# Login OAuth client selection:
# - DISCORD_CLIENT_ID can be set for a dedicated login app.
# - If unset, Fleetplanner uses DISCORD_COMPANION_BOT_ID, then
#   DISCORD_RDOCRTC_CLIENT_ID.
# - DISCORD_CLIENT_SECRET is used as the OAuth client secret.
# DISCORD_CLIENT_ID=

# Links sent by DM when a captain's unit is accepted.
# FLEETPLANNER_VOICE_CLIENT_DOWNLOAD_URL=
# FLEETPLANNER_VOICE_CLIENT_CONFIG_URL=

# Alternative login providers.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Companion auto-update
# ---------------------------------------------------------------------------
GITHUB_REPO=cccdemon/RDOC-Suite
# GITHUB_TOKEN=
# COMPANION_ASSET_PATTERN=.exe

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
# LIVEKIT_PROMETHEUS_URL=http://livekit:7880/metrics
