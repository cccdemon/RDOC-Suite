# RDOC-Suite environment example (local development).
#
# One .env at the repo root feeds every service in docker-compose. The
# authoritative per-service lists are the zod schemas:
#   apps/fleetplanner/src/config/env.ts
#   apps/mission-cover/src/config/env.ts
# Unknown keys are dropped silently - if it is not in a schema, it does nothing.
# For production start from .env.prod.template instead.

# ---------------------------------------------------------------------------
# Shared runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
SESSION_SECRET="change-me-to-a-32+-char-random-string"

# Fleetplanner database. SQLite locally; production uses the fleetplanner-db
# Postgres container (docker-compose.prod.yml builds the URL itself).
DATABASE_URL="file:./data/fleetplanner.db"

# Path prefix the app is served under. Empty locally; production is
# "/fleetplanner" because Caddy strips that prefix before the request arrives.
PUBLIC_BASE_PATH=""
WEB_PUBLIC_URL="http://localhost:3200"

# ---------------------------------------------------------------------------
# Discord OAuth login (legacy alias pair)
# Used when DISCORD_FLEETPLANNER_CLIENT_ID/_SECRET are unset.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Discord app: Fleetplanner Bot - the only bot in the suite. REST-only (no
# gateway connection, no discord.js), used for scheduled events, DMs, feedback
# tickets, announcements and the Ed25519-verified interaction buttons.
# ---------------------------------------------------------------------------
DISCORD_FLEETPLANNER_CLIENT_ID=
DISCORD_FLEETPLANNER_CLIENT_SECRET=
DISCORD_FLEETPLANNER_BOT_TOKEN=
# Ed25519 public key (Developer Portal -> General Information -> Public Key).
# Required for the event-distribution approval buttons; set the app's
# "Interactions Endpoint URL" to <WEB_PUBLIC_URL>/discord/interactions. Without
# it, approvals still work via the web inbox (Partnerships -> "Shared with us").
DISCORD_FLEETPLANNER_PUBLIC_KEY=

# Optional: Discord user ID auto-promoted to superadmin on first login, and a
# free-text contact shown to users who need to reach that superadmin.
# SUPERADMIN_DISCORD_ID=
# SUPERADMIN_CONTACT=

# Fleetplanner is multi-tenant: operations are scoped per Discord guild, guilds
# are installed self-service through the UI, and users see only servers they
# belong to. There is no global default-guild setting.

# ---------------------------------------------------------------------------
# Alternative login providers (unset = the button is hidden)
# ---------------------------------------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Mission-cover render microservice. The same secret must reach both the
# mission-cover service (required, min 32 chars) and the fleetplanner (unset =
# cover feature hidden).
# ---------------------------------------------------------------------------
# MISSIONCOVER_SERVICE_SECRET=
# MISSIONCOVER_SERVICE_URL=http://mission-cover:3300
# MISSIONCOVER_PUBLIC_URL=http://localhost:3300

# ---------------------------------------------------------------------------
# Subraum voice deep-link (subraum.cc). Unset = the voice card is hidden; the
# secret must match the init-server's ROOM_AUTH_SECRET byte for byte.
# ---------------------------------------------------------------------------
# SQUADLINK_ROOM_AUTH_SECRET=
# SQUADLINK_WS_URL=wss://squadlink.raumdock.org/ws
# SQUADLINK_STORE_URL=

# Links appended to the captain DM when a unit is accepted.
# FLEETPLANNER_VOICE_CLIENT_DOWNLOAD_URL=
# FLEETPLANNER_VOICE_CLIENT_CONFIG_URL=
