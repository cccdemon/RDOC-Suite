{
  "name": "rdoc-suite",
  "version": "0.0.0",
  "private": true,
  "description": "RDOC suite shell based on RDCC, integrating squad command, RTC sessions, and relay services.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@prisma/client": "^6.19.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild"
    ],
    "overrides": {
      "@types/react": "^18.3.18"
    }
  }
}
