# Discord Bot
# TODO: value not present in repo templates; source from existing server .env files.
DISCORD_BOT_TOKEN=
# TODO: value not present in repo templates; required by bridge, bot, and fleetplanner OAuth.
DISCORD_CLIENT_ID=
# TODO: value not present in repo templates; required by bridge and fleetplanner OAuth.
DISCORD_CLIENT_SECRET=
# TODO: value not present in repo templates; required only where Discord interaction verification is used.
DISCORD_PUBLIC_KEY=

# Database (root Prisma/bridge). Known local-dev default from .env.example; production bridge currently uses its own DB config.
DATABASE_URL="file:./dev.db"

# Bridge
# From .env.prod.template and STAND.md: suite.raumdock.org is the public bridge/admin endpoint.
BRIDGE_SERVER_URL="https://suite.raumdock.org"
# From .env.example/docker-compose defaults: bridge listens on all interfaces inside the container.
BRIDGE_HOST="0.0.0.0"
# From .env.example/docker-compose defaults: bridge service port.
BRIDGE_PORT="8787"
# TODO: value not present in repo templates; must be a stable 32+ char production secret from server env.
SESSION_SECRET=
# From .env.prod.template: Discord OAuth callback for the bridge root deployment.
OAUTH_REDIRECT_URI="https://suite.raumdock.org/auth/callback"
# From .env.example: companion uses the registered dccc://auth deep link.
COMPANION_REDIRECT_URI="dccc://auth"

# From .env.prod.template: bridge is deployed at the suite.raumdock.org root, so no stripped path prefix.
PUBLIC_BASE_PATH=""

# LiveKit
# From .env.prod.template/STAND.md: public LiveKit signaling endpoint.
LIVEKIT_URL="wss://voice.raumdock.org"
# TODO: value not present in repo templates; source from existing LiveKit/server .env.
LIVEKIT_API_KEY=
# TODO: value not present in repo templates; source from existing LiveKit/server .env.
LIVEKIT_API_SECRET=
# From .env.prod.template comments and current server IP used for SSH; LiveKit needs the public media IP.
LIVEKIT_NODE_IP="85.215.253.135"

# Voice relay bots
# TODO: value not present in repo templates; Discord guild for relay role checks.
RELAY_GUILD_ID=
# TODO: value not present in repo templates; optional role gate for relay publisher tokens.
RELAY_REQUIRED_ROLE_ID=
# TODO: value not present in repo templates; can usually reuse DISCORD_BOT_TOKEN if that bot has guild access.
RELAY_DISCORD_BOT_TOKEN=
# From .env.example/STAND.md: default relay LiveKit room name.
RELAY_LIVEKIT_ROOM="voice-relay"
# From docker-compose.prod.yml: relay bots service is reachable by compose service name on port 8788.
RELAY_BOTS_ADMIN_URL="http://relay-bots:8788"
# TODO: value not present in repo templates; shared bearer secret for bridge <-> relay-bots service-config.
RELAY_BOTS_SECRET=
# TODO: value not present in repo templates; shared admin secret for bridge -> relay-bots admin API.
RELAY_BOTS_ADMIN_SECRET=

# Monitoring
# From .env.example/docker-compose.prod.yml: bridge can scrape LiveKit metrics over the compose network.
LIVEKIT_PROMETHEUS_URL="http://livekit:7880/metrics"

# Fleetplanner
# TODO: value not present in repo templates; required by fleetplanner-db Postgres container.
FLEETPLANNER_DB_PASSWORD=
# From .env.prod.template/STAND.md: public base URL for fleetplanner links and OAuth.
FLEETPLANNER_PUBLIC_URL="https://suite.raumdock.org"
# TODO: value not present in repo templates; guild where fleet-op Discord scheduled events are created.
DISCORD_GUILD_ID=
# TODO: value not present in repo templates; optional voice channel for in-voice scheduled events.
DISCORD_EVENT_CHANNEL_ID=
# TODO: value not present in repo templates; Discord user id bootstrapped as fleetplanner superadmin.
SUPERADMIN_DISCORD_ID=

# Logging
# From .env.example: standard production log level unless debugging.
LOG_LEVEL=info
